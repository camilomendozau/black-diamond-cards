---
import background from '../assets/background2.jpeg';
import Image from 'astro/components/Image.astro';
import logo from '../assets/logo-bd.png';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Presentación Biolife</title>
	</head>
	<body>
		<header class="sticky top-0 left-0 w-full bg-white bg-opacity-90 backdrop-blur-md z-10 shadow-md">
			<a href="/">
				<h1 class="flex flex-col items-center justify-center">
					<Image src={logo} alt="logo-black-diamond" class="w-40 md:w-60 m-5"/>
				</h1>
			</a>
		</header>
		<!-- <Image src={background} alt="background-image" class="background-image"/> -->
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	body::before {
		content: "";
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image: url("../assets/background3.jpeg");
		background-repeat: no-repeat;
		background-position: center;
		background-size: 100%; /* Ajusta según necesites */
		opacity: 0.2; /* Controla la transparencia de la marca de agua */
		z-index: -1; /* Coloca detrás de todo el contenido */
		pointer-events: none; /* Permite interactuar con elementos superiores */
    }
    @media (min-width: 768px) {
        body::before {
            background-size: 100%; /* Ajusta según necesites */
        }
    } 
</style>
