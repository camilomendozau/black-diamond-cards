---
import background from '../assets/background2.jpeg';
import Image from 'astro/components/Image.astro';
import logo from '../assets/logo.avif';
import { ThemeProvider } from '../components/ThemeProvider';
import DataFetcher from '../components/DataFetcher';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Presentación Biolife</title>
	</head>
		<ThemeProvider client:load>
			<header class="sticky top-0 left-0 w-full bg-white bg-opacity-90 backdrop-blur-md z-10 shadow-md">
				<a href="/">
					<h1 class="flex flex-col items-center justify-center">
						<Image src={logo} alt="logo-biolife" class="w-40 md:w-60 m-5"/>
					</h1>
				</a>
			</header>
			<body>
				<DataFetcher client:only/>
				<slot />
			</body>
		</ThemeProvider>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	body::before {
		content: "";
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		/* background-color: var(--color-primary); */
		background-image: url("../assets/background3.jpeg");
		background-repeat: no-repeat;
		background-position: center;
		background-size: 100%;
		opacity: 0.2; 
		z-index: -1; 
		pointer-events: none; 
    }
    @media (min-width: 768px) {
        body::before {
            background-size: 100%; /* Ajusta según necesites */
        }
    } 
</style>
