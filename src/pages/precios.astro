                Lista de Precios
            </h1>
            <PDFReader src={"/docs/lista-precios.pdf"} client:only="react"/>
            <!-- <PdfViewer src={"/docs/lista-precios.pdf"} client:only="react"/> -->
        </section>
    </main>
</Layout>