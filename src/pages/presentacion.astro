                Presentacion del Negocio
            </h1>
        </div>
        <section class="video-container">
            {
                // <VideoLocal 
                //   title={"Presentacion del Negocio"} 
                //   descripcion={""}
                //   src={"/videos/presentacion.mp4"}
                //   keyNam={"presentation_video_url"}
                // />   
                <Video 
						title={"Presentacion del Negocio"} 
						keyName={"presentation_video_url"}
						defaultUrl={
							"https://youtu.be/TLdjr8X6_Co"
						}
				  client:only/>
