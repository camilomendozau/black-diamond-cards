---
import Layout from "../layouts/Layout.astro";
import VideoLocal from "../components/VideoLocal.astro";
import Video from "../components/Video.astro";
const param = Astro.url.searchParams.get('ir');
import { getDatos, idRef } from '../scripts/api';
const data = await getDatos(param || idRef || '');
---

<Layout>
  <main>
        <div class="flex flex-col items-center justify-center mt-5">
            <h1 class="md:text-5xl font-bold text-2xl" style="color: var(--color-text);">
                Presentacion del Negocio
            </h1>
        </div>
        <section class="video-container">
            {data?.presentation_video_url ?(
               <Video
                        title={"Presentacion del Negocio"}
                        descripcion={""}
                        link={data.presentation_video_url}
                />   
              ):(
                <VideoLocal 
                  title={""} 
                  descripcion={""}
                  src={"/videos/presentacion.mp4"}
                />
              )      
            }   
        </section>
  </main>
</Layout>
