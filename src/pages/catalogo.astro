---
import "../styles/global.css";
import Video from "../components/VideoPlayerLocal";
import Layout from "../layouts/Layout.astro";
import PDFReader from "../components/PDFReader.jsx";
// const param = Astro.url.searchParams.get('ir');
// import { getVideoData, idRef } from '../scripts/api';
// const data = await getVideoData(param || idRef || '');
---

<Layout>
  <main>
    <div class="flex flex-col items-center justify-center mt-5">
      <h1 class="md:text-5xl font-bold text-2xl" style="color: var(--color-text);">
        Catalogo de Productos
      </h1>
    </div>
    <section
      class="flex flex-col items-center justify-center pb-10 mb-10 p-0 video-container"
      style="border-bottom: 2px solid var(--color-primaryDark); width: 75%;"
    >
      <Video
        title={"VIDEO INTRODUCCION"}
        keyName={"catalog_video_url"}
        defaultUrl={"https://www.youtube.com/embed/E1tnA8oeqyY?si=DUoaUzGff0qIpFbi"}
      client:only/>
    </section>
    <section class="App">
      <h3 class="md:text-4xl font-bold text-2xl mb-5" style="color: var(--color-text);">
        Presentación de la capacitación
      </h3>
      <div class="pdf-reader-container">
        <PDFReader
          client:only="react"
          src={"/docs/capacitacion-de-productos.pdf"}
        />
      </div>
        <!-- <iframe
          src="/docs/capacitacion-de-productos.pdf"
          style="border: none; width:80%; height:55vh; border-radius: 20px;"
        /> -->
    </section>
    <section class="App">
      <h3 class="md:text-4xl font-bold text-2xl mb-5" style="color: var(--color-text);">
        Catálogo para tratar enfermedades
      </h3>
      <div class="pdf-reader-container">
        <PDFReader client:only="react" src={"/docs/catalogo-enfermedades.pdf"} />
      </div>
      <!-- <iframe
          src="/docs/catalogo-enfermedades.pdf"
          style="border: none; width:80%; height:100vh; border-radius: 20px;"
      /> -->
    </section>
  </main>
</Layout>

<style>
  .App {
    text-align: center;
    min-height: 20vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    font-size: calc(10px + 2vmin);
    color: white;
    height: fit-content; /* Se adapta al contenido */
    padding-bottom: 2rem;
  }
  .pdf-reader-container {
    width: 90%;
    height: 100vh;
    border: 1px solid #ccc;
    border-radius: 8px;
    overflow: hidden;
    background-color: white; /* Fondo blanco para el lector de PDF */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
</style>
