---
import LayoutTraining from "../../layouts/LayoutTraining.astro";
import VideoLocal from "../../components/VideoLocal.astro";
import ButtonRedirect from "../../components/ButtonRedirect.astro";
---

<LayoutTraining>
  <main>
    <section class="flex flex-col my-5">
      <!-- <div class="flex items-center justify-center ">
        <ButtonRedirect hrefTo="/capacitacion/modulo2" title="Pasar al Modulo 2"/>
      </div> -->
      <VideoLocal 
          title={"Modulo 1 - Introducción al Sistema de Formación"} 
          descripcion={"En este modulo aprenderás como funciona la industria de redes de mercadeo y por que trabajar en la industria."}
          src={"/videos/module1.mp4"}
        />
    </section>
  </main>
  <script src="/src/scripts/verifyAccess.js" type="module"></script> 
  <script>
    const token = localStorage.getItem("astro_training_token");
    const ts = localStorage.getItem("astro_training_ts");
    const expiresIn = 3 * 60 * 60 * 1000; // 12 horas

    if (!token || !ts || Date.now() - parseInt(ts) > expiresIn) {
      localStorage.removeItem("astro_training_token");
      localStorage.removeItem("astro_training_ts");
      window.location.href = "/acceso";
    }
</script>
</LayoutTraining>
