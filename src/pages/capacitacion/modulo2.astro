---
import LayoutTraining from "../../layouts/LayoutTraining.astro";
import VideoLocal from "../../components/VideoLocal.astro";
import ButtonRedirect from "../../components/ButtonRedirect.astro";
---

<LayoutTraining>
  <main>
    <section class="flex flex-col my-5">
      <div class="flex items-center justify-center ">
        <ButtonRedirect hrefTo="/capacitacion/modulo1" title="Volver al Modulo 1"/>
      </div>
      <VideoLocal 
          title={"Modulo 2 - Sistema de Duplicación"} 
          descripcion={"En este modulo aprenderás como duplicar tu negocio."}
          src={"/videos/module2.mp4"}
        />
    </section>
  </main>
