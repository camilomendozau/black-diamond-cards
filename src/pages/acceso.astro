---
import "../styles/global.css";
import AccessForm from "../components/AccessForm.jsx";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso al material de Black Diamond</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex items-center justify-center">
    <AccessForm client:load />
  </body>
</html>

<style>
  html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	body::before {
		content: "";
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image: url("../assets/background3.jpeg");
		background-repeat: no-repeat;
		background-position: center;
		background-size: 100%; /* Ajusta según necesites */
		opacity: 0.2; /* Controla la transparencia de la marca de agua */
		z-index: -1; /* Coloca detrás de todo el contenido */
		pointer-events: none; /* Permite interactuar con elementos superiores */
    }
    @media (min-width: 768px) {
        body::before {
            background-size: 100%; /* Ajusta según necesites */
        }
    } 
</style>
