---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Video from "../components/VideoPlayerLocal";
---

<Layout>
    <main>
        <div class="flex flex-col items-center justify-center mt-5">
            <h1 class="md:text-5xl font-bold text-2xl" style="color: var(--color-text);">
                ¿Por qué Bioliffe?
            </h1>
        </div>
        <section class="flex flex-col items-center justify-center pb-10 mb-10 p-5 video-container">
            <Video
                title={"¿Por qué Biolife?"}
                keyName={"why_bioliffe_video_url"}
                defaultUrl={"https://youtu.be/4gBR5xUmamI?si=1zUsTM12GE8KQGol"}
            client:only/>
            <!-- <VideoLocal
                title={"¿Por qué Biolife?"}
                descripcion={""}
                src={"https://www.youtube.com/embed/pEwOuenPqAU?si=bRWNIE3QJGv8KV3b"}
            /> -->
        </section>
    </main>
</Layout>