---
import "../styles/global.css";
import { Image } from 'astro:assets';
import VideoPlayerLocal from "./VideoPlayerLocal";
interface VideoProps {
    title?: string;
    descripcion?: string;
    link?:string;
}

const {title = "Video", descripcion="Descripcion" ,link="https://www.youtube.com/embed/iOEsgul1Tj0?si=1-eOcOLgnJfpOUcT"} = Astro.props;

---

<div class="w-full h-full flex flex-col items-center justify-center my-5 md:flex-row md:items-center md:justify-center md:my-10 md:snap-start">
    <div class="md:w-full md:h-5/6 w-9/10 h-4/8 aspect-video rounded-2xl overflow-hidden shadow-2xl mx-10 background-colors flex items-center justify-center md:border-[40px] border-[15px] border-transparent">
        <VideoPlayerLocal src={link} name={title} client:only />
    </div>
</div>
<style>
    h2,p{
        color: #01111b;
    }
    .container-videos{
        background-color: #e1e1e1;
    }
    /* .background-colors {
		background: rgb(2,0,36);
		background: linear-gradient(90deg,#50ae43 10%, #7bcf89 54%, #0d6320 100%);
	} */
</style>
