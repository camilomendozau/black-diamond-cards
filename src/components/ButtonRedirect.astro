---
import "../styles/global.css"

interface ButtonRedirectProps {
    hrefTo?:string;
    title?: string;
}
const {hrefTo="",title=""} = Astro.props;
---

<a 
class="w-80 h-15 font-medium bg-gradient-to-r text-zinc-800 hover:text-white py-2 px-4 rounded-full text-center shadow-2xl hover:shadow-lg transition duration-300 ease-in-out hover:scale-105 hover:from-[#33af25] hover:via-[#47bd38] hover:to-green-600 text md:text-lg p-7 flex items-center justify-center active:scale-95 border-2 border-green-700"
href={hrefTo}>
    {title}
</a>
