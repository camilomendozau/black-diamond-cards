---
import "../styles/global.css"

interface ButtonRedirectProps {
    hrefTo?:string;
    title?: string;
}
const {hrefTo="",title=""} = Astro.props;
---

<a
class="btn-redirect w-full md:w-auto font-medium py-2 px-4 rounded-lg text-center transition duration-300 ease-in-out flex items-center justify-center text-sm"
href={hrefTo}>
    {title}
</a>